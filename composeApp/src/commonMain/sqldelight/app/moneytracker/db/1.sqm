-- Schema v1 → v2: multi-currency, card limits, location, tags, photos, notes, templates, capture inbox.
ALTER TABLE Account ADD COLUMN currency TEXT;
ALTER TABLE Account ADD COLUMN cardLimit INTEGER;

ALTER TABLE Txn ADD COLUMN currency TEXT;
ALTER TABLE Txn ADD COLUMN originalAmount INTEGER;
ALTER TABLE Txn ADD COLUMN accountAmount INTEGER;
ALTER TABLE Txn ADD COLUMN lat REAL;
ALTER TABLE Txn ADD COLUMN lng REAL;

ALTER TABLE RecurringRule ADD COLUMN currency TEXT;

CREATE TABLE Currency (
    code TEXT NOT NULL PRIMARY KEY,
    symbol TEXT NOT NULL,
    decimals INTEGER NOT NULL,
    rate REAL NOT NULL,
    sortOrder INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL
);

CREATE TABLE Tag (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sortOrder INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL
);

CREATE TABLE TxnTag (
    txnId TEXT NOT NULL,
    tagId TEXT NOT NULL,
    PRIMARY KEY (txnId, tagId)
);
CREATE INDEX TxnTag_tag ON TxnTag(tagId);

CREATE TABLE Photo (
    id TEXT NOT NULL PRIMARY KEY,
    txnId TEXT NOT NULL,
    fileName TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX Photo_txn ON Photo(txnId);

CREATE TABLE Note (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    color INTEGER NOT NULL DEFAULT 0,
    pinned INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE Template (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    accountId TEXT,
    toAccountId TEXT,
    categoryId TEXT,
    amount INTEGER NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    memo TEXT NOT NULL DEFAULT '',
    sortOrder INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL
);

CREATE TABLE Capture (
    id TEXT NOT NULL PRIMARY KEY,
    receivedAt INTEGER NOT NULL,
    source TEXT NOT NULL,
    sender TEXT NOT NULL,
    text TEXT NOT NULL,
    amount INTEGER,
    kind TEXT,
    merchant TEXT NOT NULL DEFAULT '',
    accountId TEXT,
    status TEXT NOT NULL,
    txnId TEXT
);
CREATE INDEX Capture_status ON Capture(status, receivedAt);

-- Tiny Naive Bayes model learned from the user's own entries: token counts per label
-- (label = "cat:<categoryId>" or "acc:<accountId>"). A few KB; no model files.
CREATE TABLE LearnToken (
    token TEXT NOT NULL,
    label TEXT NOT NULL,
    count INTEGER NOT NULL,
    PRIMARY KEY (token, label)
);

CREATE TABLE LearnLabel (
    label TEXT NOT NULL PRIMARY KEY,
    count INTEGER NOT NULL
);
