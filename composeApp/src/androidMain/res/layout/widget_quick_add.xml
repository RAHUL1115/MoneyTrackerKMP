<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add: three pills (icon over label), from 2x1 up. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_outline" android:clipToOutline="true">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bg" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="8dp">
        <FrameLayout android:id="@+id/w_add_expense" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/w_add_expense_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_pill_expense" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
                <ImageView android:id="@+id/w_add_expense_icon" android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_qa_expense" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_add_expense_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="Expense" android:textColor="@color/widget_ink" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/w_add_income" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp">
            <ImageView android:id="@+id/w_add_income_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_pill_income" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
                <ImageView android:id="@+id/w_add_income_icon" android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_qa_income" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_add_income_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="Income" android:textColor="@color/widget_ink" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/w_add_transfer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp">
            <ImageView android:id="@+id/w_add_transfer_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_pill_neutral" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
                <ImageView android:id="@+id/w_add_transfer_icon" android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_qa_transfer" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_add_transfer_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="Transfer" android:textColor="@color/widget_ink" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
